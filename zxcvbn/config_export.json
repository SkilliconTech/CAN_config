{
    "app": "CAN Configuration Tool",
    "version": 1,
    "classic_can": {
        "bitrate": "50.000 kbits/s",
        "sampling_point": "75%",
        "sjw": "1",
        "enabled": false
    },
    "canfd": {
        "arbitration_bitrate": "500 kbits/s",
        "arbitration_sp": "80.00%",
        "arbitration_sjw": "1",
        "data_bitrate": "500 kbits/s",
        "data_sp": "80.00%",
        "data_sjw": "1",
        "enabled": false
    },
    "filters": {
        "mode": "all",
        "combine": "or",
        "rules": []
    },
    "triggers": {
        "start": {
            "type": "power_on"
        },
        "stop": {
            "type": "none"
        },
        "rearm_after_stop": false
    },
    "logging": {
        "formats": [
            "asc",
            "mf4"
        ],
        "file_split_size_bytes": 104857600,
        "file_split_time_seconds": 3600,
        "split_policy": "first_limit_reached",
        "on_sd_full": "stop",
        "on_write_error": "stop",
        "overwrite_existing": false
    }
}